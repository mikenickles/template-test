{
  "name": "arlo",
  "version": "0.1.0",
  "private": true,
  "description": "Arlo — a warm, minimal personal agent. Hub for your computer, companion app for Android.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node hub/main.ts",
    "dev": "node --watch hub/main.ts",
    "demo": "node hub/main.ts --demo",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@google/genai": "^3.3.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "openai": "^7.57.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
