# Copy this file to .env and fill in what you need. Never commit .env.

# What Lyra calls you.
LYRA_USER_NAME=

# ---- Models: add at least one key ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which one Lyra starts with: anthropic, openai, gemini or fake (practice, no key).
# You can switch any time in Settings.
LYRA_PROVIDER=anthropic

# Optional: default model names (Settings can override).
# LYRA_ANTHROPIC_MODEL=claude-haiku-5-5
# LYRA_OPENAI_MODEL=gpt-6-astra
# LYRA_GEMINI_MODEL=gemini-3.8-flash

# Optional: point the OpenAI option at a local model server instead
# (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1).
# OPENAI_BASE_URL=

# ---- Gmail (read-only) ----
# From Google Cloud Console, see README "Connect Gmail".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Where Lyra listens ----
# 127.0.0.1 = this computer only. To use Lyra from your phone over Tailscale,
# set LYRA_HOST=0.0.0.0 and set an access token (make one with: openssl rand -hex 24).
LYRA_HOST=127.0.0.1
LYRA_PORT=4310
LYRA_ACCESS_TOKEN=

# Where Lyra keeps its database, memory file and Google sign-in.
# LYRA_DATA_DIR=~/.lyra
