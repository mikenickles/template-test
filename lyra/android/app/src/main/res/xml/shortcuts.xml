<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press Lyra's icon: straight to talking, a voice memo, your tasks or Today.
     Each opens MainActivity with an extra the app already understands (lyra_capture from the
     tile and widget, lyra_hash from notifications). The last one listed shows nearest the icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.lyra.chief"
            android:targetClass="app.lyra.chief.MainActivity">
            <extra android:name="lyra_hash" android:value="#/?today" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="tasks"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tasks"
        android:shortcutShortLabel="@string/shortcut_tasks"
        android:shortcutLongLabel="@string/shortcut_tasks_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.lyra.chief"
            android:targetClass="app.lyra.chief.MainActivity">
            <extra android:name="lyra_hash" android:value="#/tasks" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="memo"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_memo"
        android:shortcutShortLabel="@string/shortcut_memo"
        android:shortcutLongLabel="@string/shortcut_memo_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.lyra.chief"
            android:targetClass="app.lyra.chief.MainActivity">
            <extra android:name="lyra_capture" android:value="memo" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="talk"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_talk"
        android:shortcutShortLabel="@string/shortcut_talk"
        android:shortcutLongLabel="@string/shortcut_talk_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.lyra.chief"
            android:targetClass="app.lyra.chief.MainActivity">
            <extra android:name="lyra_capture" android:value="quick" />
        </intent>
    </shortcut>
</shortcuts>
