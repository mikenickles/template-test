{
  "manifest_version": 3,
  "name": "Lyra",
  "version": "0.2.0",
  "description": "Lets Lyra on this computer open and use pages in its own window of this browser, asking you first before anything that sends or buys. Nothing else can use it.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Lyra", "default_popup": "popup.html", "default_icon": { "128": "icon.png" } },
  "icons": { "128": "icon.png" }
}
