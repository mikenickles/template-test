; Engine configuration file.
; Breach Line — original round-based tactical FPS.

config_version=5

[application]

config/name="Breach Line"
config/description="Original round-based tactical first-person shooter."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
GameSettings="*res://src/autoload/game_settings.gd"
Audio="*res://src/autoload/audio_manager.gd"
Fx="*res://src/autoload/fx_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="body_attackers"
3d_physics/layer_3="body_defenders"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="trigger"
3d_physics/layer_6="prop"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.1
3d/default_edge_connection_margin=0.5

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=4096
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.1, 1)
textures/vram_compression/import_etc2_astc=true
