---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — template-test" description="Learn more about the person behind this blog.">
  <header class="mb-14">
    <h1 class="mb-4">About</h1>
    <div class="accent-line"></div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="md:col-span-2 prose">
      <p>
        Welcome. This is a space where I write about the things that occupy my mind —
        technology, artificial intelligence, health, and the quieter moments of personal life.
      </p>

      <p>
        I believe in clarity. In building things with precision. In taking the time to
        understand before rushing to create. This blog is an extension of that philosophy.
      </p>
    </div>

    <aside class="border-l-2 border-neutral-900 pl-6">
      <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400 mb-6">Topics</h3>
      <div class="space-y-4">
        <div>
          <span class="text-sm font-bold text-burnt-500">Tech</span>
          <p class="text-sm text-neutral-500 mt-1 mb-0">Tools, workflows, and the craft of building software.</p>
        </div>
        <div>
          <span class="text-sm font-bold text-burnt-500">AI</span>
          <p class="text-sm text-neutral-500 mt-1 mb-0">The rapidly shifting landscape of artificial intelligence.</p>
        </div>
        <div>
          <span class="text-sm font-bold text-burnt-500">Personal</span>
          <p class="text-sm text-neutral-500 mt-1 mb-0">Reflections on life and intentional living.</p>
        </div>
        <div>
          <span class="text-sm font-bold text-burnt-500">Health</span>
          <p class="text-sm text-neutral-500 mt-1 mb-0">Physical and mental well-being, routines, and habits.</p>
        </div>
      </div>
    </aside>
  </div>

  <div class="mt-16 pt-8 border-t border-neutral-200">
    <p class="text-xs uppercase tracking-[0.15em] text-neutral-400">
      Built with Astro + Tailwind CSS. Designed in the Swiss International Typographic Style.
    </p>
  </div>
</BaseLayout>
