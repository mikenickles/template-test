---
import BaseLayout from "../layouts/BaseLayout.astro";

// In a full setup, these would come from Astro.glob or content collections.
// For now, we define them manually to match our sample posts.
const posts = [
  {
    title: "Building My First AI-Powered Side Project",
    date: "2026-02-08",
    category: "ai",
    slug: "building-my-first-ai-side-project",
    excerpt: "What I learned spending a weekend building a small tool with large language models — and why the hardest part wasn't the AI.",
  },
  {
    title: "Morning Routines That Actually Stick",
    date: "2026-02-05",
    category: "health",
    slug: "morning-routines-that-stick",
    excerpt: "After years of failed 5 AM wake-up attempts, here's the simple framework that finally worked for me.",
  },
  {
    title: "Why I Switched to a Minimal Dev Setup",
    date: "2026-02-01",
    category: "tech",
    slug: "minimal-dev-setup",
    excerpt: "Fewer tools, fewer distractions. How stripping my development environment down to the essentials made me more productive.",
  },
  {
    title: "On Slowing Down in a Fast World",
    date: "2026-01-28",
    category: "personal",
    slug: "on-slowing-down",
    excerpt: "A reflection on intentional living, saying no more often, and finding quiet in the noise.",
  },
];

const categories = ["tech", "ai", "personal", "health"];
---

<BaseLayout title="template-test — A personal blog">
  <!-- Hero -->
  <section class="mb-20">
    <h1 class="text-4xl md:text-5xl font-serif font-medium leading-tight mb-6">
      Thoughts on<br />
      <span class="text-burnt-500">technology</span>, life,<br />
      and everything between.
    </h1>
    <div class="accent-line mb-6"></div>
    <p class="text-neutral-500 max-w-md leading-relaxed">
      A space for exploring ideas in tech, AI, health, and personal growth — with intention and simplicity.
    </p>
  </section>

  <!-- Categories -->
  <section class="mb-16">
    <div class="flex gap-6">
      {categories.map((cat) => (
        <a
          href={`/blog?category=${cat}`}
          class="text-xs uppercase tracking-widest text-neutral-400 hover:text-burnt-500 no-underline transition-colors"
        >
          {cat}
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Posts -->
  <section>
    <h2 class="text-sm uppercase tracking-widest text-neutral-400 mb-10">Recent</h2>
    <div class="space-y-12">
      {posts.map((post) => (
        <article class="group">
          <a href={`/blog/${post.slug}`} class="no-underline block">
            <div class="flex items-center gap-4 mb-2">
              <span class="category-tag">{post.category}</span>
              <span class="text-neutral-300">·</span>
              <time class="text-xs text-neutral-400" datetime={post.date}>
                {new Date(post.date).toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </div>
            <h3 class="text-xl font-serif font-medium text-neutral-900 group-hover:text-burnt-500 transition-colors mb-2">
              {post.title}
            </h3>
            <p class="text-neutral-500 text-sm leading-relaxed">
              {post.excerpt}
            </p>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- View all link -->
  <div class="mt-16 pt-8 border-t border-neutral-100">
    <a href="/blog" class="text-sm uppercase tracking-widest">
      View all posts &rarr;
    </a>
  </div>
</BaseLayout>
