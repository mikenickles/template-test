---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    title: "Building My First AI-Powered Side Project",
    date: "2026-02-08",
    category: "ai",
    slug: "building-my-first-ai-side-project",
    excerpt: "What I learned spending a weekend building a small tool with large language models — and why the hardest part wasn't the AI.",
  },
  {
    title: "Morning Routines That Actually Stick",
    date: "2026-02-05",
    category: "health",
    slug: "morning-routines-that-stick",
    excerpt: "After years of failed 5 AM wake-up attempts, here's the simple framework that finally worked for me.",
  },
  {
    title: "Why I Switched to a Minimal Dev Setup",
    date: "2026-02-01",
    category: "tech",
    slug: "minimal-dev-setup",
    excerpt: "Fewer tools, fewer distractions. How stripping my development environment down to the essentials made me more productive.",
  },
  {
    title: "On Slowing Down in a Fast World",
    date: "2026-01-28",
    category: "personal",
    slug: "on-slowing-down",
    excerpt: "A reflection on intentional living, saying no more often, and finding quiet in the noise.",
  },
];

const categories = ["all", "tech", "ai", "personal", "health"];
---

<BaseLayout title="Blog — template-test" description="All posts about tech, AI, personal life, and health.">
  <header class="mb-16">
    <h1 class="mb-4">Blog</h1>
    <div class="accent-line mb-6"></div>
    <p class="text-neutral-500">Thoughts and reflections, written with care.</p>
  </header>

  <!-- Category Filter -->
  <nav class="mb-12 flex gap-6" id="category-filter">
    {categories.map((cat) => (
      <button
        data-category={cat}
        class="text-xs uppercase tracking-widest text-neutral-400 hover:text-burnt-500 transition-colors cursor-pointer bg-transparent border-none p-0 category-btn"
      >
        {cat}
      </button>
    ))}
  </nav>

  <!-- Posts -->
  <div class="space-y-12" id="posts-list">
    {posts.map((post) => (
      <article class="group post-item" data-category={post.category}>
        <a href={`/blog/${post.slug}`} class="no-underline block">
          <div class="flex items-center gap-4 mb-2">
            <span class="category-tag">{post.category}</span>
            <span class="text-neutral-300">·</span>
            <time class="text-xs text-neutral-400" datetime={post.date}>
              {new Date(post.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          </div>
          <h3 class="text-xl font-serif font-medium text-neutral-900 group-hover:text-burnt-500 transition-colors mb-2">
            {post.title}
          </h3>
          <p class="text-neutral-500 text-sm leading-relaxed">
            {post.excerpt}
          </p>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".category-btn");
  const posts = document.querySelectorAll<HTMLElement>(".post-item");

  // Check URL for initial category
  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get("category") || "all";

  function filterPosts(category: string) {
    buttons.forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.classList.add("text-burnt-500");
        btn.classList.remove("text-neutral-400");
      } else {
        btn.classList.remove("text-burnt-500");
        btn.classList.add("text-neutral-400");
      }
    });

    posts.forEach((post) => {
      if (category === "all" || post.dataset.category === category) {
        post.style.display = "";
      } else {
        post.style.display = "none";
      }
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterPosts(btn.dataset.category || "all");
    });
  });

  // Apply initial filter
  filterPosts(initialCategory);
</script>
