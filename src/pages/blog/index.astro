---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    title: "Building My First AI-Powered Side Project",
    date: "2026-02-08",
    category: "ai",
    slug: "building-my-first-ai-side-project",
    excerpt: "What I learned spending a weekend building a small tool with large language models — and why the hardest part wasn't the AI.",
  },
  {
    title: "Morning Routines That Actually Stick",
    date: "2026-02-05",
    category: "health",
    slug: "morning-routines-that-stick",
    excerpt: "After years of failed 5 AM wake-up attempts, here's the simple framework that finally worked for me.",
  },
  {
    title: "Why I Switched to a Minimal Dev Setup",
    date: "2026-02-01",
    category: "tech",
    slug: "minimal-dev-setup",
    excerpt: "Fewer tools, fewer distractions. How stripping my development environment down to the essentials made me more productive.",
  },
  {
    title: "On Slowing Down in a Fast World",
    date: "2026-01-28",
    category: "personal",
    slug: "on-slowing-down",
    excerpt: "A reflection on intentional living, saying no more often, and finding quiet in the noise.",
  },
];

const categories = ["all", "tech", "ai", "personal", "health"];
---

<BaseLayout title="Blog — template-test" description="All posts about tech, AI, personal life, and health." wide>
  <header class="mb-16">
    <h1 class="mb-4">Blog</h1>
    <div class="accent-line mb-8"></div>
    <p class="text-neutral-500 text-lg">All posts. Filtered by clarity.</p>
  </header>

  <!-- Category Filter -->
  <nav class="mb-12 flex gap-3" id="category-filter">
    {categories.map((cat) => (
      <button
        data-category={cat}
        class="text-[10px] font-semibold uppercase tracking-[0.2em] px-3 py-1.5 border border-neutral-300 text-neutral-400 hover:border-burnt-500 hover:text-burnt-500 transition-all cursor-pointer bg-transparent category-btn"
      >
        {cat}
      </button>
    ))}
  </nav>

  <!-- Posts Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-list">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="no-underline group post-item" data-category={post.category}>
        <article class="post-card">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="category-tag">{post.category}</span>
              <time class="text-[10px] font-medium uppercase tracking-[0.15em] text-neutral-400" datetime={post.date}>
                {new Date(post.date).toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 group-hover:text-burnt-500 transition-colors mb-3 leading-snug">
              {post.title}
            </h3>
            <p class="text-neutral-500 text-sm leading-relaxed m-0">
              {post.excerpt}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-neutral-100">
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-burnt-500 group-hover:tracking-[0.3em] transition-all">
              Read &rarr;
            </span>
          </div>
        </article>
      </a>
    ))}
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".category-btn");
  const posts = document.querySelectorAll<HTMLElement>(".post-item");

  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get("category") || "all";

  function filterPosts(category: string) {
    buttons.forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.classList.add("border-burnt-500", "text-burnt-500");
        btn.classList.remove("border-neutral-300", "text-neutral-400");
      } else {
        btn.classList.remove("border-burnt-500", "text-burnt-500");
        btn.classList.add("border-neutral-300", "text-neutral-400");
      }
    });

    posts.forEach((post) => {
      if (category === "all" || post.dataset.category === category) {
        post.style.display = "";
      } else {
        post.style.display = "none";
      }
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterPosts(btn.dataset.category || "all");
    });
  });

  filterPosts(initialCategory);
</script>
