---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — template-test" description="Get in touch.">
  <header class="mb-12">
    <h1 class="mb-4">Contact</h1>
    <div class="accent-line"></div>
  </header>

  <div class="prose mb-12">
    <p>
      I'd love to hear from you. Whether it's a question, a collaboration idea,
      or just a hello — feel free to reach out.
    </p>
  </div>

  <form class="space-y-8 max-w-lg" action="#" method="POST">
    <div>
      <label for="name" class="block text-xs uppercase tracking-widest text-neutral-400 mb-2">
        Name
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full border-b border-neutral-200 bg-transparent py-3 text-neutral-900 focus:border-burnt-500 focus:outline-none transition-colors"
      />
    </div>

    <div>
      <label for="email" class="block text-xs uppercase tracking-widest text-neutral-400 mb-2">
        Email
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full border-b border-neutral-200 bg-transparent py-3 text-neutral-900 focus:border-burnt-500 focus:outline-none transition-colors"
      />
    </div>

    <div>
      <label for="message" class="block text-xs uppercase tracking-widest text-neutral-400 mb-2">
        Message
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full border-b border-neutral-200 bg-transparent py-3 text-neutral-900 focus:border-burnt-500 focus:outline-none transition-colors resize-none"
      ></textarea>
    </div>

    <button
      type="submit"
      class="text-sm uppercase tracking-widest text-burnt-500 hover:text-burnt-700 bg-transparent border border-burnt-500 hover:border-burnt-700 px-8 py-3 transition-colors cursor-pointer"
    >
      Send
    </button>
  </form>

  <div class="mt-16 pt-8 border-t border-neutral-100">
    <p class="text-sm text-neutral-400">
      You can also find me on
      <a href="#" class="text-burnt-500 hover:text-burnt-700">GitHub</a>,
      <a href="#" class="text-burnt-500 hover:text-burnt-700">Twitter</a>, and
      <a href="#" class="text-burnt-500 hover:text-burnt-700">LinkedIn</a>.
    </p>
  </div>
</BaseLayout>
