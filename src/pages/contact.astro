---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — template-test" description="Get in touch.">
  <header class="mb-14">
    <h1 class="mb-4">Contact</h1>
    <div class="accent-line"></div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
    <div>
      <p class="text-neutral-500 text-lg leading-relaxed mb-8">
        I'd love to hear from you. Whether it's a question, a collaboration idea,
        or just a hello — feel free to reach out.
      </p>

      <form class="space-y-6" action="#" method="POST">
        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-[0.15em] text-neutral-400 mb-2">
            Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border-b-2 border-neutral-200 bg-transparent py-3 text-neutral-900 focus:border-burnt-500 focus:outline-none transition-colors"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-[0.15em] text-neutral-400 mb-2">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border-b-2 border-neutral-200 bg-transparent py-3 text-neutral-900 focus:border-burnt-500 focus:outline-none transition-colors"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold uppercase tracking-[0.15em] text-neutral-400 mb-2">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full border-b-2 border-neutral-200 bg-transparent py-3 text-neutral-900 focus:border-burnt-500 focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="text-xs font-bold uppercase tracking-[0.2em] bg-neutral-900 text-white hover:bg-burnt-500 px-8 py-3 transition-colors cursor-pointer border-none"
        >
          Send Message
        </button>
      </form>
    </div>

    <aside class="border-l-2 border-neutral-900 pl-8">
      <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400 mb-6">Elsewhere</h3>
      <div class="space-y-4">
        <a href="#" class="block text-sm font-semibold text-neutral-900 hover:text-burnt-500 no-underline transition-colors">
          GitHub &rarr;
        </a>
        <a href="#" class="block text-sm font-semibold text-neutral-900 hover:text-burnt-500 no-underline transition-colors">
          Twitter &rarr;
        </a>
        <a href="#" class="block text-sm font-semibold text-neutral-900 hover:text-burnt-500 no-underline transition-colors">
          LinkedIn &rarr;
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
