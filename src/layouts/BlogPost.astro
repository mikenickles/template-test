---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: string;
  category: string;
  description?: string;
}

const { title, date, category, description } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — template-test`} description={description}>
  <article>
    <!-- Post header -->
    <header class="mb-14">
      <div class="flex items-center gap-4 mb-6">
        <span class="category-tag">{category}</span>
        <time class="text-xs font-medium uppercase tracking-[0.15em] text-neutral-400" datetime={date}>
          {formattedDate}
        </time>
      </div>
      <h1 class="mb-6">{title}</h1>
      <div class="accent-line"></div>
    </header>

    <!-- Post content -->
    <div class="prose max-w-2xl">
      <slot />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t-2 border-neutral-900">
      <a href="/blog" class="text-xs font-semibold uppercase tracking-[0.15em]">
        &larr; Back to all posts
      </a>
    </div>
  </article>
</BaseLayout>
