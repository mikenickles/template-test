---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: string;
  category: string;
  description?: string;
}

const { title, date, category, description } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — template-test`} description={description}>
  <article>
    <!-- Post header -->
    <header class="mb-12">
      <span class="category-tag">{category}</span>
      <h1 class="mt-3 mb-4">{title}</h1>
      <div class="flex items-center gap-4">
        <time class="text-sm text-neutral-400" datetime={date}>
          {formattedDate}
        </time>
      </div>
      <div class="accent-line mt-8"></div>
    </header>

    <!-- Post content -->
    <div class="prose">
      <slot />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t border-neutral-100">
      <a href="/blog" class="text-sm uppercase tracking-widest">
        &larr; Back to all posts
      </a>
    </div>
  </article>
</BaseLayout>
